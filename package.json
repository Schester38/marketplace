{
  "name": "marketplace",
  "version": "1.47.40",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "npm --prefix server start",
    "lint": "eslint \"server/**/*.js\" \"client/src/**/*.jsx\" \"client/src/**/*.js\"",
    "format": "prettier --write \"server/**/*.js\" \"client/src/**/*.jsx\" \"client/src/**/*.js\" \"package.json\" \".prettierrc\""
  },
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "eslint": "^9.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6"
  }
}
