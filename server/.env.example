DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ALLOWED_ORIGIN=https://your-domain.example
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.example
GEMINI_API_KEY=
# Secret d'authentification des webhooks iKeePay ENTRANTS (facultatif).
# Si défini, le header `x-api-key` du webhook est vérifié en temps constant.
# S'il est ABSENT, les webhooks sont rejetés (fail-closed) sans traitement.
# Ne PAS réutiliser IKEEPAY_API_KEY (clé des appels sortants) ici.
IKEEPAY_WEBHOOK_SECRET=
TRANSACTION_RETENTION_DAYS=2555
NOTIFICATION_RETENTION_DAYS=90
# Confirmation email (SMTP). Sans SMTP, le lien est affiché dans la console.
SITE_URL=https://mboppi-mboppi.vercel.app
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
